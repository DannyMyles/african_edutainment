# Copy to .env and fill in. Never commit .env.
# Scripts: a Gemini key from https://aistudio.google.com/apikey (free tier), OR an OpenAI key
GEMINI_API_KEY=
# OpenAI is optional (paid); also needed for --ai-backgrounds
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides (defaults live in config/channel.yaml)
# SCRIPT_PROVIDER=gemini   # or openai
# SCRIPT_MODEL=gemini-3.8-flash
# IMAGE_MODEL=gpt-image-1
